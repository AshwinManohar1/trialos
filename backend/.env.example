# Required — OpenAI API key
OPENAI_API_KEY=sk-...

# Required — MongoDB Atlas connection string
MONGODB_URL=mongodb+srv://username:password@cluster.mongodb.net/trialos?retryWrites=true&w=majority

# Optional — defaults to "trialos"
DATABASE_NAME=trialos

# Required on Railway — Railway sets $PORT automatically, but uvicorn needs it
# In railway.json startCommand uses $PORT directly, so this isn't needed in .env
